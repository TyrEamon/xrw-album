{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xrw-album-cimg",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "cache": {
    "enabled": true,
    "cross_version_cache": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xrw-album",
      "database_id": "8ad3bd59-d501-4397-898a-e895aca1291f"
    }
  ]
}
